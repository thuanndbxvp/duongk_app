# =====================================================
# .env.production — template cho VPS ai86.click
# Copy: cp .env.production.template .env.production
#       chmod 600 .env.production
# =====================================================

# =================== DOMAIN ===================
DOMAIN=ai86.click
NEXT_PUBLIC_APP_URL=https://app.ai86.click
NEXT_PUBLIC_API_URL=https://api.ai86.click

# =================== SUPABASE ===================
# Lấy tại: Supabase Dashboard > Settings > API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=eyJ...ANON
SUPABASE_SERVICE_ROLE_KEY=eyJ...SERVICE_ROLE
SUPABASE_JWT_SECRET=super-secret-jwt-from-supabase

# Public (FE only)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...ANON

# =================== CLOUDFLARE R2 ===================
# Lấy tại: Cloudflare Dashboard > R2 > Manage R2 API Tokens
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET_UPLOADS=appdk-uploads
R2_BUCKET_RENDERS=appdk-renders
R2_BUCKET_CACHE=appdk-cache
R2_PUBLIC_CDN=https://cdn.ai86.click

# =================== MODAL.COM ===================
# Lấy tại: modal token new
MODAL_TOKEN_ID=ak-...
MODAL_TOKEN_SECRET=as-...

# =================== REDIS (nội bộ docker) ===================
REDIS_URL=redis://redis:6379/0

# =================== LLM PROVIDERS ===================
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...
ANTHROPIC_API_KEY=sk-ant-...

# =================== APP ===================
ENV=production
NODE_ENV=production
PYTHONUNBUFFERED=1

# =================== MONITORING (optional) ===================
SENTRY_DSN=
LOG_LEVEL=INFO