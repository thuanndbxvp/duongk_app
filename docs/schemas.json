{
  "components": {
    "schemas": {
      "ChannelCollectionRequest": {
        "properties": {
          "channel_id": {
            "type": "string",
            "title": "Channel Id",
            "description": "YouTube channel ID"
          },
          "max_videos": {
            "type": "integer",
            "maximum": 200.0,
            "minimum": 1.0,
            "title": "Max Videos",
            "default": 200
          }
        },
        "type": "object",
        "required": [
          "channel_id"
        ],
        "title": "ChannelCollectionRequest",
        "description": "Request to collect channel videos."
      },
      "ChannelCollectionResponse": {
        "properties": {
          "channel_id": {
            "type": "string",
            "title": "Channel Id"
          },
          "total_videos_collected": {
            "type": "integer",
            "title": "Total Videos Collected"
          },
          "quality_videos_count": {
            "type": "integer",
            "title": "Quality Videos Count"
          },
          "viral_videos_count": {
            "type": "integer",
            "title": "Viral Videos Count"
          },
          "quality_videos": {
            "items": {
              "$ref": "#/components/schemas/VideoMetadata"
            },
            "type": "array",
            "title": "Quality Videos"
          },
          "viral_videos": {
            "items": {
              "$ref": "#/components/schemas/VideoMetadata"
            },
            "type": "array",
            "title": "Viral Videos"
          }
        },
        "type": "object",
        "required": [
          "channel_id",
          "total_videos_collected",
          "quality_videos_count",
          "viral_videos_count",
          "quality_videos",
          "viral_videos"
        ],
        "title": "ChannelCollectionResponse",
        "description": "Response for channel collection."
      },
