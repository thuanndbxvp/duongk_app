        "description": "Request schema for niche validation."
      },
      "NicheValidationResponse": {
        "properties": {
          "keyword": {
            "type": "string",
            "title": "Keyword",
            "description": "Original keyword"
          },
          "total_monthly_views": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Total Monthly Views",
            "description": "Estimated monthly views"
          },
          "total_channels": {
            "type": "integer",
